[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = 4.7
reloadable = true

[libraries]

windows.debug.x86_64 = "res://modules/sim/generated/siming_gdext.debug.dll"
windows.release.x86_64 = "res://modules/sim/generated/siming_gdext.release.dll"
linux.debug.x86_64 = "res://modules/sim/generated/libsiming_gdext.debug.so"
linux.release.x86_64 = "res://modules/sim/generated/libsiming_gdext.release.so"
